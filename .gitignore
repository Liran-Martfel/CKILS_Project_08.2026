.venv/
.venv312/
.idea/
__pycache__/
*.pyc
*.egg-info/

# Per-machine memory the program builds itself (not hand-written, not shared)
ckils/week2/learned_defaults.json
ckils/week2/page_learned_defaults.json
ckils/week2/interface_text.json
ckils/week2/ckils_decisions.db

# Runtime log the uiautomation library writes automatically on errors
@AutomationLog.txt

# Screenshot saved by diagnose_focus.py - can contain whatever was on screen
ckils/week2/diagnose_focus.png

# Per-machine decision log + screenshots the program builds itself (real
# content crops of whatever was on screen at each auto-decision/override)
ckils/week2/logs/

# PyInstaller build output - rebuild with the command in PROJECT_JOURNEY.md
ckils/week2/build/
ckils/week2/dist/
ckils/week2/*.spec

# Clean, never-run exe copy prepared for handing off to other users
ckils/week2/CKILS_release/

# Raw training data: real captured text from the user's actual daily usage
# (collect_data.py's own output) - the trained model (language_model.joblib)
# is the compiled artifact that ships and is meant to be shared; this raw
# corpus stays local-only.
ckils/week2/training_data*.csv

ckils/week2/ckils_skips.db
